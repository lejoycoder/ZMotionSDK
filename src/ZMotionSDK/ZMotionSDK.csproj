<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <PackageId>ZMotionSDK</PackageId>
        <Title>ZMotionSDK</Title>
        <Version>2.2.3</Version>
        <Authors>Lejoy</Authors>
        <Description>此包为正运动二次开发包,增加了一些协议的帮助类</Description>
        <PackageIcon>ZMotion.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageOutputPath>..\..\doc\nuget</PackageOutputPath>
        <PackageReleaseNotes>修复回零、正限位和负限位DI索引为-1时的读取错误，直接返回false并跳过反转；GetDI拒绝负数索引并提供明确的参数错误提示。</PackageReleaseNotes>
        <Platforms>AnyCPU;x64</Platforms>
        <GenerateDocumentationFile>True</GenerateDocumentationFile>
        <PackageProjectUrl>https://github.com/lejoycoder/ZMotionSDK</PackageProjectUrl>
        <RepositoryUrl>https://github.com/lejoycoder/ZMotionSDK</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageTags>motion-control;zmc;zmotion;automation;dotnet</PackageTags>
    </PropertyGroup>

    <ItemGroup>
      <None Update="dll\*.dll" Pack="True" PackagePath="runtimes/win-x64/native/%(Filename)%(Extension)">
        <Link>%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
      <None Update="buildTransitive\ZMotionSDK.targets" Pack="True" PackagePath="buildTransitive/ZMotionSDK.targets" />
      <None Include="..\..\README.md" Pack="True" PackagePath="\" />
      <None Include="..\..\doc\nuget\ZMotion.png" Pack="True" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="MessageToolkit" Version="3.0.1" />
    </ItemGroup>

</Project>
